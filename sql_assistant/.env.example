# .env.example — copy to .env and fill in your values

# ── OpenAI ────────────────────────────────────────────────────────
# The app also reads "OpenAI_API" if you use the project root .env
OPENAI_API_KEY=sk-...your-key-here...

# ── SQL Server (defaults — override as needed) ────────────────────
DEST_DB_HOST=localhost
DEST_DB_PORT=1433
DEST_DB_NAME=BI_AI
DEST_DB_USER=
DEST_DB_TRUSTED_CONNECTION=yes
