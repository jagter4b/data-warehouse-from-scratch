	measure 'Max Order Value' =
			MAXX(
			    VALUES('gold fact_order_items'[order_id_bk]),
			    CALCULATE(SUM('gold fact_order_items'[line_total]))
			)
		formatString: #,##0.00
		lineageTag: 560bbecb-c4fe-4646-9357-476c5e138975

	measure 'Rolling 3M Avg Revenue' =
			VAR _anchor = LASTNONBLANKVALUE('gold dim_date'[full_date], [Total Revenue])
			RETURN AVERAGEX(
			    DATESINPERIOD('gold dim_date'[full_date], _anchor, -3, MONTH),
			    [Total Revenue]
			)
		formatString: #,##0.00
		lineageTag: b430c409-c71b-4649-9383-2dd4a101773d

	measure 'Revenue MoM Delta' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _mom_from  = DATE(YEAR(_anchor), MONTH(_anchor), 1)
			VAR _mom_to    = _anchor
			VAR _mom_pfrom = EDATE(DATE(YEAR(_anchor), MONTH(_anchor), 1), -1)
			VAR _mom_pto   = EDATE(_anchor, -1)
			VAR _curr  = CALCULATE([Total Revenue], DATESBETWEEN('gold dim_date'[full_date], _mom_from,  _mom_to))
			VAR _prior = CALCULATE([Total Revenue], DATESBETWEEN('gold dim_date'[full_date], _mom_pfrom, _mom_pto))
			RETURN _curr - _prior
		formatString: #,##0.00
		lineageTag: 182926ee-918a-4d97-8908-c3152d4120db

	measure 'Category Revenue %' =
			DIVIDE(
			    [Total Revenue],
			    CALCULATE([Total Revenue], ALL('gold dim_product'))
			)
		formatString: 0.00%
		lineageTag: 86238d11-0c49-4b60-87dc-231f176a77a1

	measure 'State Revenue %' =
