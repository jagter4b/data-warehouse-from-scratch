	measure 'Holiday Revenue per Day' =
			VAR _holidayDays =
			    CALCULATE(
			        COUNTROWS('gold dim_date'),
			        'gold dim_date'[is_holiday] = TRUE(),
			        ALL('gold dim_date')
			    )
			RETURN DIVIDE([Holiday Revenue], _holidayDays)
		formatString: #,##0.00
		lineageTag: 59f380cf-62b7-4872-a36c-6717813ad713

	measure 'Non-Holiday Revenue per Day' =
			VAR _nonHolidayDays =
			    CALCULATE(
			        COUNTROWS('gold dim_date'),
			        'gold dim_date'[is_holiday] = FALSE(),
			        ALL('gold dim_date')
			    )
			RETURN DIVIDE([Non-Holiday Revenue], _nonHolidayDays)
		formatString: #,##0.00
		lineageTag: 55207c44-aa1a-4b66-bdae-3c8f74404103

	measure 'Holiday Lift %' = DIVIDE([Holiday Revenue per Day], [Non-Holiday Revenue per Day]) - 1
		formatString: 0.00%
		lineageTag: 244385b1-a975-4160-bc55-ba857a2fe3ba

	measure 'Weekend Order Share' =
			DIVIDE(
			    CALCULATE([Total Orders], 'gold dim_date'[is_weekend] = TRUE()),
			    [Total Orders]
			)
		formatString: 0.00%
		lineageTag: fc97b607-1e9d-472d-b1b3-3debae5efedc

	measure 'AI Insight Revenue' =
			VAR _yoy     = [Revenue YoY %]
			VAR _rev     = [Total Revenue]
			VAR _dir     = IF(_yoy >= 0, "up", "down")
			VAR _pctFmt  = FORMAT(ABS(_yoy), "0.0%")
			RETURN
			    "Revenue is " & _dir & " " & _pctFmt & " YoY. " &
			    "Total GMV: " & FORMAT(_rev, "#,##0") & ". " &
			    IF(_yoy > 0.1, "Strong growth trajectory — maintain momentum.",
			       IF(_yoy < -0.05, "Revenue decline: review category mix and promotions.",
			          "Stable performance. Monitor AOV for improvement levers."))
		lineageTag: 9e70549b-86b3-49b9-91c0-4e39588961c5

	measure 'AI Insight Operations' =
			VAR _delivDays  = [Avg Delivery Days]
			VAR _onTime     = [On-Time Delivery %]
			VAR _score      = [Avg Review Score]
			RETURN
			    "Avg delivery: " & FORMAT(_delivDays, "0.0") & " days " &
			    "(" & FORMAT(_onTime, "0%") & " on-time). " &
			    "Review score: " & FORMAT(_score, "0.00") & "/5. " &
			    IF(_delivDays > 15, "⚠ Delivery above 15d threshold — logistics review needed.",
			       IF(_score < 3.8, "⚠ Review score below 3.8 — check fulfilment quality.",
			          "✓ Operations within acceptable parameters."))
		lineageTag: 0c70efab-dfd1-4148-a97f-28e5f3321480

	measure 'AI Insight Customer' =
			VAR _cust        = [Total Customers]
			VAR _repeatRate  = [Repeat Rate]
			VAR _custYoY     = [Customers YoY %]
			RETURN
			    FORMAT(_cust, "#,##0") & " unique buyers (" &
			    FORMAT(_custYoY, "+0.0%;-0.0%") & " YoY). " &
			    "Repeat rate: " & FORMAT(_repeatRate, "0.0%") & ". " &
			    IF(_repeatRate < 0.05, "⚠ Very low retention — invest in repeat-purchase campaigns.",
			       IF(_repeatRate > 0.15, "✓ Strong repeat behaviour for ecommerce.",
			          "Moderate retention. Target 90-day re-engagement window."))
		lineageTag: 0f3e2877-0385-4e8a-ae1c-a8536123a7d7

	measure 'Reactivation Window' =
			VAR _repeatTable =
			    FILTER(
			        SUMMARIZE(
			            'gold fact_order_items',
			            'gold fact_order_items'[customer_sk],
			            "OrderCount", DISTINCTCOUNT('gold fact_order_items'[order_id_bk]),
			            "FirstOrderKey", MIN('gold fact_order_items'[purchase_date_key]),
			            "LastOrderKey",  MAX('gold fact_order_items'[purchase_date_key])
			        ),
			        [OrderCount] >= 2
			    )
			VAR _avgDays =
			    AVERAGEX(
			        _repeatTable,
			        VAR _firstDate =
			            LOOKUPVALUE(
			                'gold dim_date'[full_date],
			                'gold dim_date'[date_key], [FirstOrderKey]
			            )
			        VAR _lastDate =
			            LOOKUPVALUE(
			                'gold dim_date'[full_date],
			                'gold dim_date'[date_key], [LastOrderKey]
			            )
			        RETURN DATEDIFF(_firstDate, _lastDate, DAY)
			    )
			RETURN _avgDays
		formatString: #,##0.0
		lineageTag: 63eb67a5-b5c2-4bce-8fd1-e7649258c3b7

	measure 'New Customers' =
			CALCULATE(
			    DISTINCTCOUNT('gold fact_order_items'[customer_sk]),
			    FILTER(
			        VALUES('gold fact_order_items'[customer_sk]),
			        CALCULATE(
			            DISTINCTCOUNT('gold fact_order_items'[order_id_bk]),
			            ALL('gold dim_date')
			        ) = 1
			    )
			)
		formatString: #,##0
		lineageTag: 7f3073fa-885a-4d45-ba0e-317f7ff65bb6

	measure 'New Customer Revenue' =
			CALCULATE(
			    [Total Revenue],
			    FILTER(
