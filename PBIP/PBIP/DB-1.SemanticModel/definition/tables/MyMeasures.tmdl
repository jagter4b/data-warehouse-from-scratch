	measure 'Delivery Days MoM %' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _mom_from  = DATE(YEAR(_anchor), MONTH(_anchor), 1)
			VAR _mom_to    = _anchor
			VAR _mom_pfrom = EDATE(DATE(YEAR(_anchor), MONTH(_anchor), 1), -1)
			VAR _mom_pto   = EDATE(_anchor, -1)
			VAR _curr  = CALCULATE([Avg Delivery Days], DATESBETWEEN('gold dim_date'[full_date], _mom_from,  _mom_to),  USERELATIONSHIP('gold fact_order_life_cycle'[purchase_date_key], 'gold dim_date'[date_key]))
			VAR _prior = CALCULATE([Avg Delivery Days], DATESBETWEEN('gold dim_date'[full_date], _mom_pfrom, _mom_pto), USERELATIONSHIP('gold fact_order_life_cycle'[purchase_date_key], 'gold dim_date'[date_key]))
			RETURN IF(ISBLANK(_prior) || _prior = 0, BLANK(), DIVIDE(_curr - _prior, _prior))
		formatString: 0.00%
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567801

	measure 'Review Score MoM %' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _mom_from  = DATE(YEAR(_anchor), MONTH(_anchor), 1)
			VAR _mom_to    = _anchor
			VAR _mom_pfrom = EDATE(DATE(YEAR(_anchor), MONTH(_anchor), 1), -1)
			VAR _mom_pto   = EDATE(_anchor, -1)
			VAR _curr  = CALCULATE([Avg Review Score], DATESBETWEEN('gold dim_date'[full_date], _mom_from,  _mom_to))
			VAR _prior = CALCULATE([Avg Review Score], DATESBETWEEN('gold dim_date'[full_date], _mom_pfrom, _mom_pto))
			RETURN IF(ISBLANK(_prior) || _prior = 0, BLANK(), DIVIDE(_curr - _prior, _prior))
		formatString: 0.00%
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567802

	measure 'Revenue per Customer YoY %' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _yoy_from  = DATE(YEAR(_anchor), 1, 1)
			VAR _yoy_to    = _anchor
			VAR _yoy_pfrom = DATE(YEAR(_anchor) - 1, 1, 1)
			VAR _yoy_pto   = EDATE(_anchor, -12)
			VAR _curr  = CALCULATE([Revenue per Customer], DATESBETWEEN('gold dim_date'[full_date], _yoy_from,  _yoy_to))
			VAR _prior = CALCULATE([Revenue per Customer], DATESBETWEEN('gold dim_date'[full_date], _yoy_pfrom, _yoy_pto))
			RETURN IF(ISBLANK(_prior) || _prior = 0, BLANK(), DIVIDE(_curr - _prior, _prior))
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567803

		formatStringDefinition = "+0.00%;-0.00%;0.00%"

