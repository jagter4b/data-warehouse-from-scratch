	measure 'Holiday Revenue' = CALCULATE([Total Revenue], 'gold dim_date'[is_holiday] = TRUE())
		formatString: #,##0.00
		lineageTag: 0055a7ac-f70f-4a2c-a6fc-92513097ea9f

	measure 'Non-Holiday Revenue' = CALCULATE([Total Revenue], 'gold dim_date'[is_holiday] = FALSE())
		formatString: #,##0.00
