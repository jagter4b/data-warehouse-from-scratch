	measure 'Active Anomalies' =
			VAR _delivBreach   = IF([Avg Delivery Days] > 15, 1, 0)
			VAR _scoreBreach   = IF([Avg Review Score] < 3.8, 1, 0)
			VAR _cancelBreach  = IF([Cancellation Rate] > 0.05, 1, 0)
			VAR _revBreach     = IF([Revenue MoM %] < -0.05, 1, 0)
			RETURN _delivBreach + _scoreBreach + _cancelBreach + _revBreach
		formatString: #,##0
		lineageTag: f7b0a227-efd0-40b2-a820-da5f3fb0eb0d

	measure 'Composite Risk Score' =
			VAR _delivScore   = MIN(([Avg Delivery Days] - [Delivery Target]) / [Delivery Target] * 100, 100)
			VAR _scoreRisk    = MAX((4.0 - [Avg Review Score]) / 4.0 * 100, 0)
			VAR _cancelScore  = MIN([Cancellation Rate] / 0.05 * 100, 100)
			VAR _weighted     = (_delivScore * 0.4) + (_scoreRisk * 0.35) + (_cancelScore * 0.25)
			RETURN ROUND(_weighted, 1)
		formatString: #,##0.0
		lineageTag: 588cd331-d41b-4b06-aa45-229a86768f56

