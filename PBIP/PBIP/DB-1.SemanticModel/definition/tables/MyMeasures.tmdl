	measure 'Cumulative Seller Revenue %' =
			VAR _sellerRank =
			    RANKX(
			        ALL('gold dim_seller'[seller_sk]),
			        [Total Revenue],
			        ,
			        DESC,
			        Dense
			    )
			VAR _cumRev =
			    CALCULATE(
			        [Total Revenue],
			        FILTER(
			            ALL('gold dim_seller'[seller_sk]),
			            RANKX(
			                ALL('gold dim_seller'[seller_sk]),
			                CALCULATE([Total Revenue]),
			                ,
			                DESC,
			                Dense
			            ) <= _sellerRank
			        )
			    )
			VAR _totalRev = CALCULATE([Total Revenue], ALL('gold dim_seller'))
			RETURN DIVIDE(_cumRev, _totalRev)
		formatString: 0.00%
		lineageTag: 1762dc00-8e79-4e6c-9e6f-ff7a75b10b4b

