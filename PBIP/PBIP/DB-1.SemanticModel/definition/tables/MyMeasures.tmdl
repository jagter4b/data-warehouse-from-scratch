	measure 'Operational Health Score' =
			VAR _fulfillment  = [Fulfillment Rate]
			VAR _onTime       = [On-Time Delivery %]
			VAR _reviewScore  = [Review Score %]
			VAR _paySuccess   = [Payment Success %]
			VAR _mqlConv      = [MQL Conversion Rate]
			RETURN DIVIDE(_fulfillment + _onTime + _reviewScore + _paySuccess + _mqlConv, 5)
		formatString: 0.00%
		lineageTag: 84bfe892-3f0e-4c0c-a7b5-b9d5a6ddd123

	measure 'Top Revenue State' =
			FIRSTNONBLANK(
			    TOPN(
			        1,
			        VALUES('gold dim_customer'[customer_state]),
			        [Total Revenue],
			        DESC
			    ),
			    1
			)
		lineageTag: b3a7c2f1-d4e8-4a9c-b1f0-e5d9a8c7b2e1

	measure 'Revenue PM' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _mom_from  = DATE(YEAR(_anchor), MONTH(_anchor), 1)
			VAR _mom_to    = _anchor
			VAR _mom_pfrom = EDATE(DATE(YEAR(_anchor), MONTH(_anchor), 1), -1)
			VAR _mom_pto   = EDATE(_anchor, -1)
			RETURN CALCULATE([Total Revenue], DATESBETWEEN('gold dim_date'[full_date], _mom_pfrom, _mom_pto))
		formatString: #,##0.00
		lineageTag: 4a5e739c-3030-487a-b1f1-9e87ca38a7bf

	measure 'Revenue PQ' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _q_mo      = (INT((MONTH(_anchor) - 1) / 3)) * 3 + 1
			VAR _qoq_from  = DATE(YEAR(_anchor), _q_mo, 1)
			VAR _qoq_to    = _anchor
			VAR _qoq_pfrom = EDATE(DATE(YEAR(_anchor), _q_mo, 1), -3)
			VAR _qoq_pto   = EDATE(_anchor, -3)
			RETURN CALCULATE([Total Revenue], DATESBETWEEN('gold dim_date'[full_date], _qoq_pfrom, _qoq_pto))
		formatString: #,##0.00
		lineageTag: 7ab0dee5-c55c-4592-a32e-b0065cb7f0bd

	measure 'Revenue PY' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _yoy_from  = DATE(YEAR(_anchor), 1, 1)
			VAR _yoy_to    = _anchor
			VAR _yoy_pfrom = DATE(YEAR(_anchor) - 1, 1, 1)
			VAR _yoy_pto   = EDATE(_anchor, -12)
			RETURN CALCULATE([Total Revenue], DATESBETWEEN('gold dim_date'[full_date], _yoy_pfrom, _yoy_pto))
		formatString: #,##0.00
		lineageTag: 6efb7d24-6dd2-4036-9431-54ebedead880

	measure 'Revenue MoM %' =
			VAR _maxKey    = CALCULATE(MAX('gold fact_order_items'[purchase_date_key]), ALL('gold fact_order_items'))
			VAR _anchor_nf = MAXX(FILTER(ALL('gold dim_date'), 'gold dim_date'[date_key] = _maxKey), 'gold dim_date'[full_date])
			VAR _anchor    = IF(
			                   ISFILTERED('gold dim_date'[full_date]),
			                   MAX('gold dim_date'[full_date]),
			                   _anchor_nf
			               )
			VAR _mom_from  = DATE(YEAR(_anchor), MONTH(_anchor), 1)
			VAR _mom_to    = _anchor
