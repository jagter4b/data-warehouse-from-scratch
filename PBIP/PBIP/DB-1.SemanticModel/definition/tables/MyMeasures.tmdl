	measure 'Revenue CAGR' =
			VAR _firstYearRev =
			    CALCULATE(
			        [Total Revenue],
			        FILTER(
			            ALL('gold dim_date'),
			            'gold dim_date'[year] = CALCULATE(MIN('gold dim_date'[year]), ALL('gold dim_date'))
			        )
			    )
			VAR _lastYearRev =
			    CALCULATE(
			        [Total Revenue],
			        FILTER(
			            ALL('gold dim_date'),
			            'gold dim_date'[year] = CALCULATE(MAX('gold dim_date'[year]), ALL('gold dim_date'))
			        )
			    )
			VAR _years =
			    CALCULATE(MAX('gold dim_date'[year]), ALL('gold dim_date')) -
			    CALCULATE(MIN('gold dim_date'[year]), ALL('gold dim_date'))
			RETURN IF(_years > 0, POWER(DIVIDE(_lastYearRev, _firstYearRev), DIVIDE(1, _years)) - 1, BLANK())
		formatString: 0.00%
		lineageTag: 07826599-9dc6-46f9-9cb1-cb5797f847de

	measure 'Base Forecast' = [Revenue PM] * (1 + [Revenue MoM %])
		formatString: #,##0.00
