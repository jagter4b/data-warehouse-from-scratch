table MyMeasures
	lineageTag: 52ec6ae4-1967-4d57-a79a-f9c8894c3d25

	measure 'Active Filters Count' =
			COALESCE(
			    COUNTROWS(
			        FILTER(
			            {
			                IF(ISFILTERED('gold dim_date'[full_date]), 1, BLANK()),
			                IF(ISFILTERED('gold dim_customer'[customer_state]), 1, BLANK()),
			                IF(ISFILTERED('gold dim_seller'[seller_state]), 1, BLANK()),
			                IF(ISFILTERED('gold dim_product'[product_category_name]), 1, BLANK()),
			                IF(ISFILTERED('gold dim_order_status'[order_status]), 1, BLANK()),
			                IF(ISFILTERED('gold dim_payment_type'[payment_type]), 1, BLANK())
			            },
			            NOT ISBLANK([Value])
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 82588f57-4c5c-48f6-8beb-8b3d59120d10

